# Copy to .env and fill in. Do NOT commit .env.

# Workers use the Supabase direct connection string with service-role privileges
# (postgres user or service role). Never use the anon key here.
# Supabase → Project Settings → Database → Connection string (URI, port 5432).
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Ingestion worker (PRD 001) ---------------------------------------------
INGEST_INTERVAL_SECONDS=180
MARKET_OPEN=09:15
MARKET_CLOSE=15:35
INSTRUMENTS=NIFTY
# INSTRUMENTS=NIFTY,BANKNIFTY
ARCHIVE_RAW=true
ARCHIVE_DIR=nifty_data
FETCH_INDIA_VIX=false
NSE_TIMEOUT=15
NSE_MAX_RETRIES=3
EXPIRY_MODE=nearest

# --- Insights engine (PRD 004) ----------------------------------------------
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# INSIGHTS_MODEL_CHEAP=google/gemini-2.0-flash-001
# INSIGHTS_MODEL_PREMIUM=anthropic/claude-sonnet-4
# INSIGHTS_PREMIUM_NATIVE=false
# ANTHROPIC_API_KEY=sk-ant-...
# INSIGHTS_ESCALATE_CONFIDENCE=0.6
# INSIGHTS_MAX_TOOL_CALLS=8
# INSIGHTS_MAX_TOKENS=4096

# --- Backend API (PRD 002) --------------------------------------------------
# Same DATABASE_URL as workers; API sets role=authenticated per request (never service-role in responses).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=<jwt-secret-from-supabase-project-settings>
WEB_ORIGIN=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000
# Local dev only — mints JWTs for /docs and curl testing. Never true in production.
ENABLE_DEV_TOKEN=false
DEV_TOKEN_TTL_SECONDS=3600

# --- Frontend (PRD 003) — copy to apps/web/.env.local -----------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key-from-supabase-project-settings>
NEXT_PUBLIC_API_URL=http://localhost:8000
